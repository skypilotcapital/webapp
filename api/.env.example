# SkyPilot Capital — webapp environment variables
# Copy this file to .env and fill in the values. Never commit .env to git.

# PostgreSQL connection
# On the droplet: DB_HOST=localhost (FastAPI is on the same machine as PostgreSQL)
# Local dev via SSH tunnel: DB_HOST=localhost (tunnel forwards 5432 to droplet)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skypilot
DB_USER=skypilot_app
DB_PASSWORD=

# CORS — JSON list of allowed frontend origins
# Local dev only:
CORS_ORIGINS=["http://localhost:3000"]
# Production (add your Vercel URL here once deployed):
# CORS_ORIGINS=["https://your-app.vercel.app"]

# [08-APIAUTH] Shared secret with the website's proxy (Vercel env API_PROXY_SECRET — SAME value).
# Every request except /health must carry it as X-Skypilot-Proxy or the API answers 401; when it
# is EMPTY the API answers 503 to everything except /health (fail closed). Generate with
#   openssl rand -hex 32
# ⚠️ No inline comment on the value line: the systemd unit loads this file via EnvironmentFile=,
# which does NOT strip comments (operational_findings.md, database_backup_runbook).
PROXY_SECRET=
